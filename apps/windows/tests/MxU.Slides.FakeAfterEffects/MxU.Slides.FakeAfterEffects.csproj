<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for After Effects, for the bridge's tests (After Effects isn't installed on the
       test PCs). The tests copy it in as "aerender.exe" and "AfterFX.exe"; it behaves as whichever
       it's called, driven by what's in the (text) project file it's given. Not a test project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>MxU.Slides.FakeAfterEffects</RootNamespace>
  </PropertyGroup>
</Project>
