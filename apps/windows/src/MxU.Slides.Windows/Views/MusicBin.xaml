<UserControl x:Class="MxU.Slides.Windows.Views.MusicBin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MxU.Slides.Windows.Views"
             xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels">
    <!--
        The Music tab: songs and playlists as tiles (click plays or stops, right-click for the
        playlist and song commands), and beside them the songs of the playlist playing now
        (else the one last chosen), the one playing marked. The fade and crossfade buttons and
        Manage… sit above the list. Its DataContext is the MainViewModel (from the main window).
    -->
    <UserControl.Resources>
        <v:NotNullToVisibility x:Key="VisibleWhenSet" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="Tiles" ItemsSource="{Binding AudioTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AudioTileViewModel}">
                            <Border x:Name="Frame" Width="170" Height="92" Margin="0,0,8,0" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent"
                                    Background="#1A2233" Cursor="Hand" MouseLeftButtonUp="Tile_Click" MouseRightButtonUp="Tile_RightClick"
                                    ToolTip="Click to play or stop · right-click for more">
                                <DockPanel Margin="10,8">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedText}" />
                                    <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xEC4F;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item}" Value="{x:Null}">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE8FD;" />
                                    <Setter TargetName="Frame" Property="Background" Value="#202A3D" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Width="120" Height="92" Click="NewPlaylist_Click" ToolTip="A music playlist: songs in an order, with Repeat, Shuffle and a crossfade">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="New playlist" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Width="450" Margin="10,0,0,0" Padding="8,4" CornerRadius="5" Background="#141414" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Manage…" Click="Manage_Click" Padding="8,1" ToolTip="Playlists, their songs, Repeat, Shuffle and crossfades; rename, replace or delete songs" />
                    <Button x:Name="CrossfadeButton" DockPanel.Dock="Right" Content="{Binding MusicCrossfadeLabel}" Click="Crossfade_Click" Style="{StaticResource GhostButton}"
                            Margin="0,0,4,0" ToolTip="Crossfade between songs" />
                    <Button x:Name="FadeButton" DockPanel.Dock="Right" Content="{Binding MusicFadeLabel}" Click="Fade_Click" Style="{StaticResource GhostButton}"
                            Margin="0,0,4,0" ToolTip="Fade on play, pause and stop" />
                    <Button DockPanel.Dock="Right" Click="Mute_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,0" ToolTip="Mute or unmute all music">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding MusicMuteGlyph}" />
                    </Button>
                    <TextBlock Text="{Binding MusicTracksTitle}" ToolTip="{Binding MusicTracksTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0"
                               Visibility="{Binding ShownPlaylist, Converter={StaticResource VisibleWhenSet}, ConverterParameter=invert}"
                               Text="Click a playlist to see its songs here. Right-click a song to add it to a playlist." />
                    <ListBox x:Name="Tracks" ItemsSource="{Binding MusicTracks}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShownPlaylist, Converter={StaticResource VisibleWhenSet}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <EventSetter Event="MouseDoubleClick" Handler="Track_DoubleClick" />
                                <EventSetter Event="MouseRightButtonUp" Handler="Track_RightClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MusicTrackViewModel}">
                                <DockPanel ToolTip="Double-click to play the playlist from here">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource FaintText}" Margin="6,0,0,0" />
                                    <TextBlock x:Name="Mark" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="10" Width="16"
                                               Foreground="{StaticResource FaintText}" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontSize="11" Width="20" Foreground="{StaticResource FaintText}" />
                                    <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedText}" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Mark" Property="Text" Value="&#xE768;" />
                                        <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Good}" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
