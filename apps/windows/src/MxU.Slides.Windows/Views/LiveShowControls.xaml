<UserControl x:Class="MxU.Slides.Windows.Views.LiveShowControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels"
             xmlns:v="clr-namespace:MxU.Slides.Windows.Views">
    <!--
        Under the audience preview: the auto-advance chip, the video transport strip and the Clear
        controls (Clear All, each function, each layer). The DataContext is the MainViewModel.
    -->
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="Visible" />
        <v:NotNullToVisibility x:Key="VisibleWhenSet" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="GoodWash" Color="#1F7ED957" />
        <SolidColorBrush x:Key="GoodEdge" Color="#667ED957" />

        <!-- A Clear button: green while what it clears has something live (as on the Mac). -->
        <Style x:Key="LiveClear" TargetType="Button" BasedOn="{StaticResource ClearButton}">
            <Setter Property="Command" Value="{Binding DataContext.ClearButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="Content" Value="{Binding Label}" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                    <Setter Property="Background" Value="{StaticResource GoodWash}" />
                    <Setter Property="BorderBrush" Value="{StaticResource GoodEdge}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Auto advance: the time until this slide (or video) moves on; click to hold it. -->
        <Button x:Name="AutoAdvanceChip" Command="{Binding ToggleAutoAdvanceHoldCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="10,3"
                Visibility="{Binding AutoAdvanceVisible, Converter={StaticResource Visible}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="ToolTip" Value="Time until this slide advances on its own. Click to hold it (the video keeps playing)." />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AutoAdvanceHeld}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentWash}" />
                            <Setter Property="ToolTip" Value="Auto advance is held: the video keeps playing, the room stays. Click to let it go again (an end that already passed stays skipped)." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE72A;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoAdvanceHeld}" Value="True">
                                    <Setter Property="Text" Value="&#xE769;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding AutoAdvanceCaption}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding AutoAdvanceTime}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- The live video's transport. -->
        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TransportHasVideo}" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button x:Name="LayerPicker" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="LayerPicker_Click" Padding="4,2" Margin="0,0,4,0"
                        ToolTip="Playing videos by layer, top of the stack first: pick which one the strip controls">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE81E;" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding TransportLayerName}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" MaxWidth="78" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="8" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- A looping background shows only what's left of this pass (pick it to control it). -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding TransportShowsControls, Converter={StaticResource Visible}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding TransportRemainingText}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding TransportName}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <DockPanel Visibility="{Binding TransportShowsControls, Converter={StaticResource Visible}}">
                    <Button x:Name="BackToStart" DockPanel.Dock="Left" Command="{Binding TransportBackToStartCommand}" Width="30" Padding="0" Margin="0,0,3,0"
                            ToolTip="Back to the start (playing or paused stays as it was)">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE892;" FontSize="11" />
                    </Button>
                    <Button x:Name="PlayPause" DockPanel.Dock="Left" Command="{Binding TransportPlayPauseCommand}" Width="30" Padding="0" Margin="0,0,6,0">
                        <TextBlock FontFamily="{StaticResource Icons}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TransportPlaying}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TransportFinished}" Value="True">
                                            <Setter Property="Text" Value="&#xE72C;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="SkipToEnd" DockPanel.Dock="Right" Command="{Binding TransportSkipToEndCommand}" Padding="5,0" Margin="6,0,0,0" MinWidth="40"
                            ToolTip="Jump to near the end (right-click to change how near)" MouseRightButtonUp="SkipToEnd_RightClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE893;" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <TextBlock Text="{Binding TransportSkipCaption}" FontSize="10" VerticalAlignment="Center" FontFamily="Consolas" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TransportName}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        <Slider x:Name="Scrub" Minimum="0" Maximum="{Binding TransportDuration}" Value="{Binding TransportPosition, Mode=TwoWay}"
                                IsMoveToPointEnabled="True" IsEnabled="{Binding TransportHasVideo}"
                                PreviewMouseLeftButtonDown="Scrub_MouseDown" PreviewMouseLeftButtonUp="Scrub_MouseUp" ValueChanged="Scrub_ValueChanged"
                                ToolTip="Drag to seek: playing or paused stays as it was" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TransportRemainingText}" Style="{StaticResource Muted}" FontSize="10" FontFamily="Consolas" />
                            <Button x:Name="GoToTime" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="2,0" MinHeight="14" Margin="0,0,3,0"
                                    Click="GoToTime_Click" ToolTip="Click to type an exact time to go to">
                                <TextBlock Text="{Binding TransportElapsedText}" FontSize="10" FontFamily="Consolas" />
                            </Button>
                            <TextBlock Text="{Binding TransportTotalText, StringFormat=/ {0}}" Style="{StaticResource Muted}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Clear -->
        <TextBlock Text="CLEAR" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
        <Button x:Name="ClearAllButton" Command="{Binding ClearAllCommand}" Padding="6,7" Margin="0,0,0,4"
                ToolTip="Clear every function the checklist ticks (F1). Right-click to choose what Clear All clears."
                MouseRightButtonUp="ClearAll_RightClick">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="#5A1D1D" />
                    <Setter Property="BorderBrush" Value="#7F1D1D" />
                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClearAllHasContent}" Value="True">
                            <Setter Property="Background" Value="#7F1D1D" />
                            <Setter Property="BorderBrush" Value="#B91C1C" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <TextBlock Text="Clear All  F1" />
        </Button>
        <TextBlock Text="{Binding ClearAllNote}" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                   Visibility="{Binding ClearAllNote, Converter={StaticResource VisibleWhenSet}}" />
        <ItemsControl ItemsSource="{Binding ClearFunctionButtons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ClearButtonViewModel}">
                    <Button Style="{StaticResource LiveClear}" ToolTip="{Binding Help}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ToggleButton x:Name="LayersToggle" Padding="6,2" Margin="0,2,0,6" HorizontalAlignment="Left"
                      ToolTip="Clear one layer at a time (green means live)">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE81E;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Clear a layer" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <ItemsControl ItemsSource="{Binding ClearLayerButtons}"
                      Visibility="{Binding IsChecked, ElementName=LayersToggle, Converter={StaticResource Visible}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ClearButtonViewModel}">
                    <Button Style="{StaticResource LiveClear}" HorizontalContentAlignment="Left" ToolTip="{Binding Help}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
