<UserControl x:Class="MxU.Slides.Windows.Views.Volunteer.VolunteerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels"
             xmlns:r="clr-namespace:MxU.Slides.Windows.Rendering"
             xmlns:v="clr-namespace:MxU.Slides.Windows.Views"
             Background="{StaticResource BasePlane}">
    <!--
        Volunteer mode's layout (Phase 8): everything a volunteer needs to run the service, and
        nothing that edits. The service on the left, its slides as one scroll in the middle, the
        live preview with Next, Previous and the clears on the right, and the bins volunteers keep
        along the bottom. It swaps in for the main window's content while volunteer mode is on
        (VolunteerLayout.cs); the DataContext is the same MainViewModel.
    -->
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="Visible" />
        <v:NotNullToVisibility x:Key="VisibleWhenSet" />
        <v:SixteenByNine x:Key="SixteenByNine" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- A small picture tile in the bins (an overlay or a picture), ringed red while it's up. -->
        <DataTemplate x:Key="OverlayTile" DataType="{x:Type vm:OverlayTileViewModel}">
            <Border x:Name="Frame" Width="150" Margin="0,0,8,0" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" Background="#141414"
                    Cursor="Hand" MouseLeftButtonUp="OverlayTile_Click" ToolTip="Click to put it up or take it down">
                <Grid>
                    <r:SceneView StaticScene="{Binding Preview}" PlaysVideo="False" Height="84" />
                    <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="5,2">
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="MediaTile" DataType="{x:Type vm:MediaTileViewModel}">
            <Border x:Name="Frame" Width="150" Margin="0,0,8,0" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" Background="#141414"
                    Cursor="Hand" MouseLeftButtonUp="MediaTile_Click" ToolTip="Click to show it">
                <Grid>
                    <r:SceneView StaticScene="{Binding Preview}" PlaysVideo="False" Height="84" />
                    <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="5,2">
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- The top bar: volunteer mode is on, the service, and the way out. -->
        <Border DockPanel.Dock="Top" Background="#181818" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Image Source="/Assets/AppIcon256.png" Width="24" Height="24" DockPanel.Dock="Left" />
                <TextBlock Text="MxU Slides" FontSize="15" FontWeight="SemiBold" Margin="10,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Border DockPanel.Dock="Left" Background="{StaticResource Accent}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72E;" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="VOLUNTEER MODE" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="LeaveButton" DockPanel.Dock="Right" Click="Leave_Click" Padding="12,4"
                        ToolTip="Back to Show and Edit (asks for this computer's PIN when it has one)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE785;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Leave Volunteer Mode…" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="OutputStatus" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="Running the show only: songs, services and screens can't be changed here."
                           Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Notices (the same as the main window's). -->
        <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="12,6" Visibility="{Binding Notice, Converter={StaticResource VisibleWhenSet}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding DismissNoticeCommand}" Content="Dismiss" />
                <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- The bins volunteers keep: overlays, media, music and combos (click to run, nothing to edit). -->
        <Border x:Name="Bins" DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="8,0,8,8" Height="150">
            <DockPanel>
                <StackPanel x:Name="BinTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" />
                <Grid>
                    <ScrollViewer x:Name="OverlayBin" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Overlays}" ItemTemplate="{StaticResource OverlayTile}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MediaBin" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MediaItems}" ItemTemplate="{StaticResource MediaTile}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel x:Name="MusicBin">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Command="{Binding MusicPreviousCommand}" Content="⏮" ToolTip="Previous song" Margin="0,0,4,0" />
                            <Button Command="{Binding MusicPlayPauseCommand}" Content="⏯" ToolTip="Play / pause" Margin="0,0,4,0" />
                            <Button Command="{Binding MusicNextCommand}" Content="⏭" ToolTip="Next song" Margin="0,0,4,0" />
                            <Button Command="{Binding MusicStopCommand}" Content="⏹" ToolTip="Stop (fades out)" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding NowPlaying}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AudioTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AudioTileViewModel}">
                                        <Button Width="150" Height="56" Margin="0,0,8,0" Command="{Binding DataContext.AudioTileClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Play it, or stop it while it plays">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    <ScrollViewer x:Name="ComboBin" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Combos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="140" Height="84" Margin="0,0,8,0" Command="{Binding DataContext.RunComboCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                        <StackPanel>
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="380" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- The service: pick a row to see it, double-click to take it live. -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SERVICE" Style="{StaticResource SectionLabel}" />
                    <v:ServicePicker DockPanel.Dock="Top" Margin="0,0,0,8" />
                    <ListBox x:Name="Rows" ItemsSource="{Binding ServiceItems}" SelectedItem="{Binding SelectedServiceItem}" MouseDoubleClick="Rows_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Num" Text="{Binding Number}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock x:Name="Icon" Grid.Column="1" FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedText}" FontSize="12" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="ItemName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"
                                                   Visibility="{Binding Detail, Converter={StaticResource VisibleWhenSet}}" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{StaticResource Live}" CornerRadius="3" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
                                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="ItemName" Property="Foreground" Value="{Binding Accent}" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{Binding Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- The slides: the whole service as one scroll. -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                <v:ContinuousSlidesView x:Name="Slides" AlwaysShown="True" />
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Live: the preview, Next and Previous, the clears, and the panels volunteers keep. -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LiveColumn">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Background="{StaticResource Live}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="AUDIENCE" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding LiveDetail}" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LiveTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border CornerRadius="4" ClipToBounds="True" Background="Black">
                                <r:SceneView x:Name="Preview" PlaysVideo="True" PlaybackScope="live" v:PreviewShape.FollowsTarget="True" />
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding PreviousCommand}" Margin="0,0,4,0" Padding="8,10" ToolTip="Previous slide (Left arrow)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76B;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Previous" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding NextCommand}" Style="{StaticResource AccentButton}" Margin="4,0,0,0" Padding="8,10"
                                        ToolTip="Next slide (Right arrow, Space, Enter)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Next" />
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76C;" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <v:LiveShowControls Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <v:ServiceTrackingPanel x:Name="TrackingPanel" Margin="0,0,0,8" />
                    <Border x:Name="TimersBox" Style="{StaticResource Panel}" Margin="0,0,0,8"><v:TimersPanel /></Border>
                    <Border x:Name="AlertsBox" Style="{StaticResource Panel}" Margin="0,0,0,8"><v:AlertsPanel /></Border>
                    <Border x:Name="StageMessageBox" Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="STAGE MESSAGE" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding AlertText, UpdateSourceTrigger=PropertyChanged}" Tag="Message to stage…" KeyDown="StageMessage_KeyDown" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox Content="Audience too" IsChecked="{Binding AlertOnAudience}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="Send" Style="{StaticResource AccentButton}" Command="{Binding ShowAlertCommand}" Margin="0,0,6,0" />
                                <Button Content="Clear" Click="StageMessageClear_Click" ToolTip="Take the message down (F6)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
