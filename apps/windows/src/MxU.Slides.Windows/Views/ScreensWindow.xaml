<Window x:Class="MxU.Slides.Windows.Views.ScreensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screens" Width="1000" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BasePlane}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Done" IsDefault="True" IsCancel="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Done_Click" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Identify displays" Click="Identify_Click" Margin="0,0,8,0" ToolTip="Flash each display's number and name on it" />
                <TextBlock x:Name="Footer" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Text="SCREENS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ Add screen" Click="AddScreen_Click" Margin="0,0,6,0" />
                    <Button x:Name="RemoveButton" Content="Remove" Click="RemoveScreen_Click" />
                </StackPanel>
                <ListBox x:Name="ScreenList" SelectionChanged="ScreenList_SelectionChanged" Background="{StaticResource Card}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Details" Margin="0,0,8,0">
                    <TextBlock Text="SCREEN" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" />
                        <TextBox x:Name="ScreenName" Grid.Column="1" LostFocus="Identity_Changed" KeyDown="Identity_KeyDown" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Shows" VerticalAlignment="Center" />
                        <ComboBox x:Name="RoleCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="Role_Changed" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="ScreenWidth" Width="70" LostFocus="Identity_Changed" KeyDown="Identity_KeyDown" />
                            <TextBlock Text=" × " VerticalAlignment="Center" />
                            <TextBox x:Name="ScreenHeight" Width="70" LostFocus="Identity_Changed" KeyDown="Identity_KeyDown" />
                            <ComboBox x:Name="SizePresets" Width="170" Margin="10,0,0,0" SelectionChanged="SizePreset_Changed" ToolTip="Common sizes" />
                            <ComboBox x:Name="FpsCombo" Width="80" Margin="10,0,0,0" SelectionChanged="Fps_Changed" ToolTip="Frames per second (for NDI and DeckLink)" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Fit" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScaleCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="Scale_Changed" Margin="0,2"
                                  ToolTip="When the slides' shape differs from this screen: show it all (bars at the sides) or fill it (trim the edges)" />
                        <TextBlock Grid.Row="4" Text="Look" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <ComboBox x:Name="LookCombo" Width="250" SelectionChanged="Look_Changed"
                                      ToolTip="Show the live slide on this screen through another theme (a lower third on the stream, say) while the other screens show it as designed" />
                            <ComboBox x:Name="LookScopeCombo" Width="250" Margin="10,0,0,0" SelectionChanged="LookScope_Changed"
                                      ToolTip="Which of the theme's designs to use: all of them, one folder of them, or just one" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ScreenStatus" Style="{StaticResource Muted}" FontSize="11" Margin="110,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="LookStatus" Style="{StaticResource Muted}" FontSize="11" Margin="110,2,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="LAYOUT" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="LayoutCombo" Width="170" SelectionChanged="Layout_Changed" />
                        <TextBlock Text="Outputs" VerticalAlignment="Center" Margin="14,0,6,0" />
                        <ComboBox x:Name="CountCombo" Width="60" SelectionChanged="Count_Changed" />
                        <TextBlock x:Name="OverlapLabel" Text="Overlap" VerticalAlignment="Center" Margin="14,0,6,0" />
                        <Slider x:Name="OverlapSlider" Width="160" Minimum="0" Maximum="0.2" SmallChange="0.005" LargeChange="0.02" VerticalAlignment="Center"
                                ValueChanged="Overlap_Changed" ToolTip="How much neighbouring projectors overlap, for edge blending" />
                        <TextBlock x:Name="OverlapValue" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="LayoutHelp" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="OUTPUTS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Choose what carries each output: a display connected to this PC, an NDI source on the network (NDI Tools must be installed), or a Blackmagic DeckLink card (Desktop Video must be installed). Click an output to correct it below." />
                    <StackPanel x:Name="SliceRows" />

                    <TextBlock x:Name="CorrectionsTitle" Text="CORRECTIONS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                    <TextBlock x:Name="CorrectionsHelp" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <StackPanel x:Name="CorrectionRows" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Reset corrections" Click="ResetCorrections_Click" Margin="0,0,10,0" />
                        <Button Content="Masks…" Click="Masks_Click" Margin="0,0,10,0"
                                ToolTip="Black out parts of this screen (a pillar, a speaker stack) or show only a shape" />
                        <CheckBox x:Name="TestPattern" Content="Show the alignment grid on this screen" VerticalAlignment="Center" Click="TestPattern_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Video delay" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="DelayCombo" Width="110" SelectionChanged="Delay_Changed"
                                  ToolTip="Holds this output back a few frames so it lines up with a slower screen or the sound" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="(saved with the screen; applied to NDI and DeckLink outputs)" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
