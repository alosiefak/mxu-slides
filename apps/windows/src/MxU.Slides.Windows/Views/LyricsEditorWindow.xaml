<Window x:Class="MxU.Slides.Windows.Views.LyricsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels"
        xmlns:r="clr-namespace:MxU.Slides.Windows.Rendering"
        xmlns:v="clr-namespace:MxU.Slides.Windows.Views"
        Title="{Binding WindowTitle}" Width="1180" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <v:SixteenByNine x:Key="SixteenByNine" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.5*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Title" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Author" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="CCLI song #" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding CcliNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Key" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding MusicKey, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Copyright" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                <TextBox Text="{Binding Copyright, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,6">
                Type or paste the words. Put a section name on its own line (Verse 1, Chorus, Bridge, Pre-Chorus, Tag, Intro…).
                A blank line starts a new slide. Chords in square brackets like [G] are kept for the stage display.
                Pasting a SongSelect or ChordPro text fills in the title and credits for you.
            </TextBlock>
            <TextBox Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas" FontSize="14" Padding="10" />
        </DockPanel>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Lines per slide" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox SelectedItem="{Binding LinesPerSlide}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:Int32}" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                                    <sys:Int32>1</sys:Int32>
                                    <sys:Int32>2</sys:Int32>
                                    <sys:Int32>3</sys:Int32>
                                    <sys:Int32>4</sys:Int32>
                                    <sys:Int32>5</sys:Int32>
                                    <sys:Int32>6</sys:Int32>
                                    <sys:Int32>8</sys:Int32>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Play order (optional)" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                <TextBox Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example: Intro, V1, C, V2, C, B, C x2" />
                <TextBlock Text="e.g. V1, C, V2, C, B, C x2  (V = Verse, C = Chorus, B = Bridge, PC = Pre-Chorus, T = Tag)"
                           Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,10" />
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,8" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Preview}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SlideTileViewModel}">
                            <Border Width="186" Margin="0,0,8,8" CornerRadius="4" Background="#141414" ClipToBounds="True">
                                <StackPanel>
                                    <r:SceneView StaticScene="{Binding Scene}"
                                                 Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SixteenByNine}}" />
                                    <Grid Background="{Binding GroupBrush}" Height="18">
                                        <TextBlock Margin="5,0" VerticalAlignment="Center" FontSize="10" Foreground="White">
                                            <Run Text="{Binding Number, Mode=OneWay}" />
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Save song" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="110" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
