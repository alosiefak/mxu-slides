<UserControl x:Class="MxU.Slides.Windows.Views.AnimationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels"
             xmlns:v="clr-namespace:MxU.Slides.Windows.Views">
    <!--
        The Animation tab of the overlay, theme and stage layout editors: add an effect (or a
        Change) to the selected objects, apply a preset, see every step in the order it plays
        (drag one onto another to reorder), and change the selected step. The data comes from
        AnimationTabViewModel; the timeline (AnimationTimelineView) sits under each editor's canvas.
    -->
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="Visible" />
        <v:NotNullToVisibility x:Key="VisibleWhenSet" />
        <v:InverseBool x:Key="Not" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <CollectionViewSource x:Key="GroupedSteps" Source="{Binding StepRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <ScrollViewer x:Name="AnimationScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <TextBlock Text="ADD AN EFFECT" Style="{StaticResource SectionLabel}" />
            <ComboBox SelectedIndex="{Binding GalleryKindIndex}" Margin="0,0,0,6">
                <ComboBoxItem Content="Bring in" />
                <ComboBoxItem Content="Take out" />
                <ComboBoxItem Content="Emphasize" />
                <ComboBoxItem Content="Change (move or restyle to a pose)" />
            </ComboBox>
            <DockPanel Margin="0,0,0,6" Visibility="{Binding IsOverlay, Converter={StaticResource Visible}, ConverterParameter=invert}">
                <TextBlock Text="Plays" Style="{StaticResource Muted}" Width="44" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding AddSlotIndex}" ToolTip="When a new step plays: on a click (Next), with the slide as it arrives, or at the very end">
                    <ComboBoxItem Content="On a click (an Out at the end)" />
                    <ComboBoxItem Content="With the slide (no click)" />
                    <ComboBoxItem Content="At the end (final)" />
                </ComboBox>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding GalleryTiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GalleryTile}">
                        <Button Content="{Binding Title}" MinWidth="74" Margin="0,0,4,4"
                                Command="{Binding DataContext.AddEffectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding GalleryTarget}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10" />

            <!-- Presets and one step per line/word (ViewModels/AnimationTabViewModel.cs) -->
            <TextBlock Text="PRESETS" Style="{StaticResource SectionLabel}" />
            <!-- Point at a tile to see it play; click to pick it, double-click to apply it (Views/AnimationPresetGallery.cs). -->
            <v:AnimationPresetGallery x:Name="PresetGallery" Margin="0,0,0,6" />
            <TextBlock Text="{Binding SelectedPreset.Name, FallbackValue='Pick a preset above'}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Apply" Command="{Binding ApplyPresetCommand}" CommandParameter="replace" Margin="0,0,4,4" ToolTip="Replace the selected objects' steps with the preset" />
                <Button Content="Add" Command="{Binding ApplyPresetCommand}" CommandParameter="add" Margin="0,0,4,4" ToolTip="Add the preset's steps after theirs" />
                <Button Content="Save as preset…" Command="{Binding SavePresetAsCommand}" Margin="0,0,4,4" ToolTip="Save the selected object's steps as a preset of your own" />
                <Button Content="Delete" Command="{Binding DeletePresetCommand}" IsEnabled="{Binding CanDeletePreset}" Margin="0,0,4,4" />
            </WrapPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="One step per" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="Line" Command="{Binding GenerateStepsCommand}" CommandParameter="line" Margin="0,0,4,0"
                        ToolTip="Each line of the selected text gets its own step (the kind chosen above), one after another" />
                <Button Content="Word" Command="{Binding GenerateStepsCommand}" CommandParameter="word" HorizontalAlignment="Left"
                        ToolTip="Each word of the selected text gets its own step, one after another" />
            </DockPanel>

            <TextBlock Text="STEPS, IN PLAY ORDER" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="No animations yet: it cuts (or dissolves) on and off. Select an object and pick an effect above."
                       Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                       Visibility="{Binding HasSteps, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <TextBlock Text="Drag a step onto another to play it there." Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                       Visibility="{Binding HasSteps, Converter={StaticResource Visible}}" />
            <ListBox x:Name="StepList" ItemsSource="{Binding Source={StaticResource GroupedSteps}}" SelectedItem="{Binding SelectedStepRow}"
                     Background="{StaticResource Card}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="StepList_PreviewMouseWheel" AllowDrop="True"
                     PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown" PreviewMouseMove="StepList_PreviewMouseMove"
                     DragOver="StepList_DragOver" Drop="StepList_Drop">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="4,8,4,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StepRowViewModel}">
                        <DockPanel Margin="2,2" Background="Transparent">
                            <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding KindColor}" VerticalAlignment="Top" Margin="0,5,7,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Timing}" Style="{StaticResource Muted}" FontSize="10" />
                                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warn}" FontSize="10" TextWrapping="Wrap"
                                           Visibility="{Binding Warning, Converter={StaticResource VisibleWhenSet}}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The selected step's settings -->
            <Border x:Name="StepEditorPanel" Style="{StaticResource Panel}" Margin="0,8,0,0"
                    Visibility="{Binding StepEditor, Converter={StaticResource VisibleWhenSet}}">
                <StackPanel DataContext="{Binding StepEditor}" Margin="0,0,4,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warn}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding Warning, Converter={StaticResource VisibleWhenSet}}" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="Earlier" Margin="0,0,4,4" ToolTip="Play it one step sooner"
                                Command="{Binding DataContext.MoveStepEarlierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="Later" Margin="0,0,4,4" ToolTip="Play it one step later"
                                Command="{Binding DataContext.MoveStepLaterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Margin="0,0,4,4" ToolTip="Preview from this step"
                                Command="{Binding DataContext.PreviewStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" />
                        </Button>
                        <Button Content="Copy" Margin="0,0,4,4" ToolTip="A copy of this step, just after it"
                                Command="{Binding DataContext.DuplicateStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="Remove" Margin="0,0,4,4"
                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Move to" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <Button x:Name="MoveUpButton" Content="The start" Margin="0,0,4,4" CommandParameter="up"
                                Command="{Binding DataContext.MoveStepToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button x:Name="MoveClickButton" Content="A new click" Margin="0,0,4,4" CommandParameter="click"
                                Command="{Binding DataContext.MoveStepToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button x:Name="MoveDownButton" Content="The end" Margin="0,0,4,4" CommandParameter="down"
                                Command="{Binding DataContext.MoveStepToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Effect" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="110" Margin="0,0,6,0"
                                  IsEnabled="{Binding IsMorph, Converter={StaticResource Not}}" />
                        <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding Effect}" />
                    </DockPanel>

                    <!-- A change (morph): its end state is posed on the canvas -->
                    <StackPanel Visibility="{Binding IsMorph, Converter={StaticResource Visible}}" Margin="0,0,0,6">
                        <TextBlock Text="A change moves, resizes or restyles the object to a pose you set on the canvas."
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <WrapPanel>
                            <ToggleButton x:Name="PoseButton" Content="{Binding DataContext.PoseButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          IsChecked="{Binding DataContext.Posing, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,4,4" Padding="10,3"
                                          ToolTip="While on, the canvas shows where the change ends: move, resize or restyle the object there (the faint copy is where it starts)" />
                            <Button Content="Reset" Margin="0,0,4,4" ToolTip="Back to how it looks before the change (nothing changes)"
                                    Command="{Binding DataContext.ResetPoseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- An In's custom start: "where it enters from" -->
                    <StackPanel Visibility="{Binding IsIn, Converter={StaticResource Visible}}" Margin="0,0,0,6">
                        <CheckBox Content="Enters from where you place it" IsChecked="{Binding HasCustomStart}"
                                  ToolTip="Instead of the effect's own start, it travels from a pose you set on the canvas (park it off the edge to fly in from there)" />
                        <ToggleButton Content="{Binding DataContext.PoseButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding DataContext.Posing, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="20,4,0,0" Padding="10,3"
                                      HorizontalAlignment="Left" Visibility="{Binding HasCustomStart, Converter={StaticResource Visible}}"
                                      ToolTip="While on, the canvas shows where it starts: drag it there (the faint copy is where it lands)" />
                    </StackPanel>

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Plays" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding TriggerIndex}" ToolTip="On click · with the previous step (together) · after the previous step · on exit (final)">
                            <ComboBoxItem Content="On click" />
                            <ComboBoxItem Content="With previous" />
                            <ComboBoxItem Content="After previous" />
                            <ComboBoxItem Content="Final (when it leaves)" />
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Speed" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Right" Text="{Binding Duration, UpdateSourceTrigger=LostFocus}" Width="50" Margin="6,0,0,0" ToolTip="Seconds"
                                 KeyDown="NumberBox_KeyDown" Visibility="{Binding IsCustomSpeed, Converter={StaticResource Visible}}" />
                        <ComboBox SelectedIndex="{Binding SpeedIndex}">
                            <ComboBoxItem Content="Quick (0.3s)" />
                            <ComboBoxItem Content="Normal (0.5s)" />
                            <ComboBoxItem Content="Slow (1s)" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Delay" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" Width="60" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown" />
                    </DockPanel>
                    <TextBlock Text="{Binding DelayHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="64,0,0,6" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Ease" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding RampIndex}" Width="110" HorizontalAlignment="Left" ToolTip="How it speeds up and slows down">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="In" />
                            <ComboBoxItem Content="Out" />
                            <ComboBoxItem Content="Both" />
                        </ComboBox>
                    </DockPanel>
                    <CheckBox Content="With fade" IsChecked="{Binding WithFade}" Margin="64,0,0,6" Visibility="{Binding ShowsWithFade, Converter={StaticResource Visible}}" />

                    <!-- Move -->
                    <StackPanel Visibility="{Binding IsMove, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="From" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{Binding MoveFromIndex}" Width="110" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                                <ComboBoxItem Content="Top" />
                                <ComboBoxItem Content="Bottom" />
                                <ComboBoxItem Content="Offset" />
                            </ComboBox>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="64,0,0,6" Visibility="{Binding UsesOffset, Converter={StaticResource Visible}}">
                            <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding OffsetX, UpdateSourceTrigger=LostFocus}" Width="54" Margin="0,0,8,0" KeyDown="NumberBox_KeyDown" />
                            <TextBlock Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding OffsetY, UpdateSourceTrigger=LostFocus}" Width="54" KeyDown="NumberBox_KeyDown" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Wipe -->
                    <StackPanel Visibility="{Binding IsWipe, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="From" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{Binding WipeFromIndex}" Width="110" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                                <ComboBoxItem Content="Top" />
                                <ComboBoxItem Content="Bottom" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Soft edge" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SoftEdge, UpdateSourceTrigger=LostFocus}" Width="54" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown" />
                        </DockPanel>
                    </StackPanel>
                    <!-- Scale -->
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding IsScale, Converter={StaticResource Visible}}">
                        <TextBlock Text="From size" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <TextBox Text="{Binding FromScale, UpdateSourceTrigger=LostFocus}" Width="54" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown"
                                 ToolTip="1 is its own size; 0.5 half" />
                    </DockPanel>
                    <!-- Blur, burn, glitch, pulse -->
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding UsesAmount, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus}" Width="54" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown" />
                    </DockPanel>
                    <!-- Type -->
                    <WrapPanel Margin="64,0,0,6" Visibility="{Binding IsType, Converter={StaticResource Visible}}">
                        <CheckBox Content="Cursor" IsChecked="{Binding Cursor}" Margin="0,0,10,0" />
                        <CheckBox Content="Type from the end" IsChecked="{Binding Reverse}" />
                    </WrapPanel>
                    <!-- Draw -->
                    <StackPanel Visibility="{Binding IsDraw, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Start at" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Text="{Binding DrawStart, UpdateSourceTrigger=LostFocus}" Width="50" Margin="6,0,0,0" KeyDown="NumberBox_KeyDown"
                                     ToolTip="0 to 1, around the outline from the top left" />
                            <ComboBox SelectedIndex="{Binding DrawStartIndex}">
                                <ComboBoxItem Content="Top left" />
                                <ComboBoxItem Content="Top right" />
                                <ComboBoxItem Content="Bottom right" />
                                <ComboBoxItem Content="Bottom left" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>
                        </DockPanel>
                        <CheckBox Content="Counter-clockwise" IsChecked="{Binding Reverse}" Margin="64,0,0,6" />
                    </StackPanel>
                    <!-- Color -->
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding IsColor, Converter={StaticResource Visible}}">
                        <TextBlock Text="Colour" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                        <v:ColorPicker Hex="{Binding ColorHex}" HorizontalAlignment="Left" />
                    </DockPanel>
                    <CheckBox Content="Blank underline while hidden" IsChecked="{Binding PlaceholderUnderline}" Margin="64,0,0,6"
                              Visibility="{Binding HasRanges, Converter={StaticResource Visible}}" />

                    <!-- Camera push (the Mac's AnimationInspector "Camera Push") -->
                    <StackPanel Visibility="{Binding ShowsCameraPush, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                        <CheckBox Content="Camera push" IsChecked="{Binding CameraPush}"
                                  ToolTip="The program video moves into the space this object leaves free, in step with this animation. Put it on the Out too so the picture returns." />
                        <StackPanel Margin="20,4,0,0" Visibility="{Binding CameraPush, Converter={StaticResource Visible}}">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Video" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                                <ComboBox SelectedIndex="{Binding PushModeIndex}">
                                    <ComboBoxItem Content="Push (crop in)" />
                                    <ComboBoxItem Content="Push (letterbox)" />
                                    <ComboBoxItem Content="Blur background" />
                                </ComboBox>
                            </DockPanel>
                            <StackPanel Visibility="{Binding PushMoves, Converter={StaticResource Visible}}">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Video sits" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                                    <ComboBox SelectedIndex="{Binding PushAlignmentIndex}" Width="110" HorizontalAlignment="Left"
                                              ToolTip="Where the video sits in the space the object leaves">
                                        <ComboBoxItem Content="Centre" />
                                        <ComboBoxItem Content="Left" />
                                        <ComboBoxItem Content="Right" />
                                        <ComboBoxItem Content="Top" />
                                        <ComboBoxItem Content="Bottom" />
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox Content="Blurred video backdrop" IsChecked="{Binding PushBackdrop}" Margin="64,0,0,6"
                                          ToolTip="A blurred copy of the video fills the space around the pushed one" />
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Margin" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding PushMargin, UpdateSourceTrigger=LostFocus}" Width="54" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown"
                                             ToolTip="Space between the video and the object (0 to 400)" />
                                </DockPanel>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Extra zoom" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                                <TextBox Text="{Binding PushZoom, UpdateSourceTrigger=LostFocus}" Width="54" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown"
                                         ToolTip="1 to 2: the video a little closer" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6" Visibility="{Binding ShowsPushBlur, Converter={StaticResource Visible}}">
                                <TextBlock Text="Blur" Style="{StaticResource Muted}" Width="64" VerticalAlignment="Center" />
                                <TextBox Text="{Binding PushBlur, UpdateSourceTrigger=LostFocus}" Width="54" HorizontalAlignment="Left" KeyDown="NumberBox_KeyDown"
                                         ToolTip="0 to 200" />
                            </DockPanel>
                            <TextBlock Text="The preview moves a stand-in video. On the program it moves your live input." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
