<!--
    Styles for the automation editors (action combos, slide actions, the scheduler).
    Themes/Dark.xaml's menu items are single-level; the Add Action menu needs submenus
    (Timer › Start › Sermon), so this item has a popup for its children. EditorKit.cs
    loads this file and gives the style to every item of the menus it builds.
    DynamicResource finds the app's colours (Text, Card, Border …) in Themes/Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CascadingMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="10,5" MinWidth="170">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                                <!-- The › only shows on items that open a submenu. -->
                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="›" Margin="16,0,0,0" Foreground="{DynamicResource MutedText}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <!-- MenuItem opens and closes PART_Popup itself, as the mouse moves over the item. -->
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-4" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="3">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentWash}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small round "On" / "Paused" chip (the scheduler's enable switches). -->
    <Style x:Key="ChipToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" MinWidth="48">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
