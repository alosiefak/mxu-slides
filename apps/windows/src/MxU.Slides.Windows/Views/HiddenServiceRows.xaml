<UserControl x:Class="MxU.Slides.Windows.Views.HiddenServiceRows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels"
             xmlns:v="clr-namespace:MxU.Slides.Windows.Views">
    <!--
        Under the run order: "HIDDEN (n)", the rows hidden from the run of show (Next, the stage and
        timelines skip them), each with Unhide. As the Mac's hiddenGroupRow / hiddenRow. The
        DataContext is the MainViewModel.
    -->
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="Visible" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <StackPanel Visibility="{Binding HasHiddenServiceItems, Converter={StaticResource Visible}}" Margin="0,6,0,0">
        <Button Command="{Binding ToggleHiddenGroupCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="2,1"
                ToolTip="Rows hidden from the run of show: Next, the stage and timelines skip them">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="8" Width="14" VerticalAlignment="Center" Foreground="{StaticResource FaintText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE76C;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HiddenGroupOpen}" Value="True">
                                    <Setter Property="Text" Value="&#xE70D;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding HiddenGroupTitle}" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding HiddenServiceItems}" Visibility="{Binding HiddenGroupOpen, Converter={StaticResource Visible}}"
                      MaxHeight="140" Margin="14,2,0,0">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Content="Unhide" Style="{StaticResource GhostButton}" FontSize="11" Padding="6,0" MinHeight="20"
                                Command="{Binding DataContext.UnhideServiceItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource FaintText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
