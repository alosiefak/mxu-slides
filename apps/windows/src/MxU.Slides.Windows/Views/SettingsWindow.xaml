<Window x:Class="MxU.Slides.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screens &amp; Settings" Width="660" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock Text="SCREENS" Style="{StaticResource SectionLabel}" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10">
            Choose which display shows the room (Audience) and which shows the band and speaker (Stage).
            On a laptop with one screen, leave them on "Preview window" to see the outputs in ordinary windows.
        </TextBlock>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Audience" VerticalAlignment="Center" />
            <ComboBox x:Name="AudienceCombo" Grid.Column="1" />
            <TextBlock Grid.Row="2" Text="Stage" VerticalAlignment="Center" />
            <ComboBox x:Name="StageCombo" Grid.Row="2" Grid.Column="1" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Identify displays" Click="Identify_Click" Margin="0,0,8,0" />
            <Button Content="Refresh list" Click="Refresh_Click" Margin="0,0,8,0" />
            <Button Content="More screens, NDI, DeckLink, edge blending…" Click="Screens_Click" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <CheckBox x:Name="OutputsAtLaunch" Content="Turn outputs on when MxU Slides starts (if their displays are connected)" />
        <CheckBox x:Name="PreventSleep" Content="Keep the computer and screens awake while an output is showing" />

        <TextBlock Text="TRANSITIONS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Slides" VerticalAlignment="Center" ToolTip="When a slide and its presentation don't choose a transition" />
            <ComboBox x:Name="TransitionCombo" Grid.Column="1" />
            <Slider x:Name="TransitionSeconds" Grid.Column="3" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" ValueChanged="TransitionSeconds_ValueChanged" />
            <TextBlock x:Name="TransitionLabel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Muted}" Margin="0,4,0,8" FontSize="11" />
            <TextBlock Grid.Row="2" Text="Media" VerticalAlignment="Center" ToolTip="When a background or video doesn't choose a transition" />
            <ComboBox x:Name="MediaTransitionCombo" Grid.Row="2" Grid.Column="1" />
            <Slider x:Name="MediaTransitionSeconds" Grid.Row="2" Grid.Column="3" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" ValueChanged="MediaTransitionSeconds_ValueChanged" />
            <TextBlock x:Name="MediaTransitionLabel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="11" />
        </Grid>
        <!-- Present: the Mac's "Show a repeated chord-only section once" and "Confidence NEXT skips blank slides" (Views/Operator). -->
        <v:PresentSettingsSection xmlns:v="clr-namespace:MxU.Slides.Windows.Views" />

        <TextBlock Text="NEW SONGS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeCombo" Grid.Column="1" DisplayMemberPath="Name" />
            <TextBlock Grid.Column="3" Text="Lines per slide" VerticalAlignment="Center" />
            <ComboBox x:Name="LinesCombo" Grid.Column="4" Width="70" HorizontalAlignment="Left" />
        </Grid>

        <TextBlock Text="SOUND" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Video volume" VerticalAlignment="Center" />
            <Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource Muted}" Margin="90,4,0,0" FontSize="11" Text="Background loops are always silent; foreground videos play their sound." />
        <v:SoundSettingsPanel xmlns:v="clr-namespace:MxU.Slides.Windows.Views" x:Name="SoundPanel" Margin="0,12,0,0" />

        <TextBlock Text="MIDI CONTROL" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <DockPanel>
            <ComboBox x:Name="MidiChannel" DockPanel.Dock="Right" Width="110" ToolTip="Listen on one MIDI channel, or all of them" />
            <CheckBox x:Name="MidiEnabled" Content="Let MIDI notes run the show (same notes as ProPresenter)" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="MidiDevices" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,4" TextWrapping="Wrap" />
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Send MIDI out to" VerticalAlignment="Center" Width="120" />
            <ComboBox x:Name="MidiOutCombo" ToolTip="Where slide actions and combos send MIDI when they don't name an output (a lighting desk, a mixer…)" />
        </DockPanel>
        <Expander Header="MIDI devices" Foreground="{StaticResource Text}" Margin="0,0,0,6">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                           Text="Name the MIDI devices the show talks to (ProPresenter's import here too). Once any device takes input, MIDI control listens only to the devices that are on, on their channel." />
                <StackPanel x:Name="MidiDeviceRows" Margin="0,6,0,4" />
                <Button Content="+ Add a connected device" HorizontalAlignment="Left" Click="AddMidiDevice_Click" />
            </StackPanel>
        </Expander>
        <Expander Header="Note for each command" Foreground="{StaticResource Text}" Margin="0,0,0,0">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl x:Name="MidiMapRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,3">
                                <TextBox DockPanel.Dock="Right" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding NoteName}" Style="{StaticResource Muted}" Width="44" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>

        <TextBlock Text="TIMECODE IN" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <DockPanel>
            <ComboBox x:Name="TimecodeChannel" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" SelectionChanged="TimecodeChannel_Changed"
                      ToolTip="The input channel the LTC arrives on" />
            <TextBlock Text="Read from" VerticalAlignment="Center" Width="120" />
            <ComboBox x:Name="TimecodeInput" SelectionChanged="TimecodeInput_Changed"
                      ToolTip="LTC from a sound input (an audio interface channel), or MTC from a MIDI input" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="TimecodeReadout" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
            <CheckBox x:Name="TimecodeFollows" Content="Follow it (songs whose timeline follows timecode play by themselves)" VerticalAlignment="Center" Click="TimecodeFollows_Click" />
        </DockPanel>
        <DockPanel Margin="0,4,0,0">
            <TextBox x:Name="TimecodeOffset" DockPanel.Dock="Right" Width="48" TextChanged="TimecodeOffset_Changed" ToolTip="Frames early (−) or late (+), from −30 to 30" />
            <TextBlock DockPanel.Dock="Right" Text="Offset (frames)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <CheckBox x:Name="TimecodePlaysAudio" Content="Also play the timelines' music" VerticalAlignment="Center" Click="TimecodePlaysAudio_Click"
                      ToolTip="Usually off: under timecode the band's playback rig plays the music" />
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="These apply straight away and belong to this PC. Turn on Follow timecode for a song from the ⋯ menu on its timeline." />

        <TextBlock Text="NETWORK &amp; API" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <DockPanel>
            <TextBox x:Name="ApiPort" DockPanel.Dock="Right" Width="64" ToolTip="Port (6980 unless something else uses it)" />
            <TextBlock DockPanel.Dock="Right" Text="Port" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <CheckBox x:Name="ApiEnabled" Content="Let phones, tablets and other apps on this network control the show" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="ApiConnect" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,4" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Copy default key" Click="CopyDefaultKey_Click" Margin="0,0,8,0" ToolTip="Paste it into the remote app or a script's Authorization header" />
            <Button Content="Open API docs" Click="OpenApiDocs_Click" />
        </StackPanel>
        <Expander Header="Manage keys" Foreground="{StaticResource Text}">
            <StackPanel Margin="0,6,0,0">
                <ItemsControl x:Name="ApiKeyRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right" Content="Revoke" Tag="{Binding Id}" Click="RevokeKey_Click" Padding="8,2" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Prefix, StringFormat={}{0}…}" Style="{StaticResource Muted}" Width="90" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Scope}" Style="{StaticResource Muted}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="New key" Click="NewKey_Click" />
                    <ComboBox x:Name="NewKeyScope" DockPanel.Dock="Right" Width="90" Margin="6,0"
                              ToolTip="View: read only · Control: run the show · Edit: also change the library" />
                    <TextBox x:Name="NewKeyName" Tag="Name, e.g. Worship leader's iPad" />
                </DockPanel>
            </StackPanel>
        </Expander>

        <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <TextBlock x:Name="LibraryPath" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Open library folder" Click="OpenLibrary_Click" Margin="0,0,8,0" />
            <Button Content="Open backups" Click="OpenBackups_Click" Margin="0,0,8,0" />
            <Button Content="Open logs" Click="OpenLogs_Click" />
        </StackPanel>
        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Import ProPresenter library…" Click="ImportProPresenterLibrary_Click" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                       Text="Moving from ProPresenter 7? Bring in its presentations, media, themes, props, messages, stage layouts and playlists. Run it again later to pick up changes; anything you've edited here is kept." />
        </DockPanel>
        <!-- About: the version and the bundled fonts' credits and licence (Views/AboutSection.cs). -->
        <v:AboutSection xmlns:v="clr-namespace:MxU.Slides.Windows.Views" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
