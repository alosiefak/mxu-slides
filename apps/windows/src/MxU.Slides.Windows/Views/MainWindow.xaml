<Window x:Class="MxU.Slides.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MxU.Slides.Windows.ViewModels"
        xmlns:r="clr-namespace:MxU.Slides.Windows.Rendering"
        xmlns:v="clr-namespace:MxU.Slides.Windows.Views"
        Title="MxU Slides" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Icon="/Assets/AppIcon.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <v:BoolToVisibility x:Key="Visible" />
        <v:NotNullToVisibility x:Key="VisibleWhenSet" />
        <v:SixteenByNine x:Key="SixteenByNine" />
        <v:InverseBool x:Key="Not" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- One slide in the grid: thumbnail, group colour, number and label. Red outline = live. -->
        <DataTemplate x:Key="SlideTile" DataType="{x:Type vm:SlideTileViewModel}">
            <Border x:Name="Frame" Margin="0,0,10,12" CornerRadius="6" BorderThickness="3" BorderBrush="Transparent" Background="#141414"
                    Width="{Binding DataContext.Settings.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Cursor="Hand" ToolTip="{Binding NotesTooltip}"
                    MouseLeftButtonUp="SlideTile_Click" MouseRightButtonUp="SlideTile_RightClick">
                <StackPanel>
                    <r:SceneView StaticScene="{Binding Scene}" Letterbox="#000000"
                                 Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SixteenByNine}}" />
                    <Grid Background="{Binding GroupBrush}" Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" Margin="6,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Foreground="White" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="160" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Image Source="/Assets/AppIcon256.png" Width="26" Height="26" DockPanel.Dock="Left" />
                <TextBlock Text="MxU Slides" FontSize="16" FontWeight="SemiBold" Margin="10,0,18,0" VerticalAlignment="Center" DockPanel.Dock="Left" />

                <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsEditing, Converter={StaticResource Not}}" Padding="12,4"
                              ToolTip="Show mode: clicking a slide takes it live">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Show" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsEditing}" Padding="12,4" Margin="4,0,16,0"
                              ToolTip="Edit mode: clicking a slide selects it for editing (Ctrl+E)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70F;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </ToggleButton>

                <Button DockPanel.Dock="Left" Click="NewSong_Click" ToolTip="New song from lyrics (Ctrl+N)" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="New Song" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding NewPresentationCommand}" ToolTip="New presentation (Ctrl+Shift+N)" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F4;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="New Presentation" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Click="Import_Click" IsEnabled="{Binding IsImporting, Converter={StaticResource Not}}"
                        ToolTip="Import PowerPoint decks and lyrics files: SongSelect, ChordPro or plain text (Ctrl+I)" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B5;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Click="Settings_Click" ToolTip="Screens and settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F8;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Screens &amp; Settings" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="StageOutput_Click" Margin="0,0,6,0" ToolTip="Turn the stage display on or off">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StageDot" Width="9" Height="9" Fill="{StaticResource FaintText}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StageStatus" Text="Stage: Off" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="AudienceOutput_Click" Margin="0,0,6,0" ToolTip="Turn the audience output on or off">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AudienceDot" Width="9" Height="9" Fill="{StaticResource FaintText}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="AudienceStatus" Text="Audience: Off" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Notices -->
        <StackPanel Grid.Row="1">
            <Border Background="#1E3A5F" Padding="12,6" Visibility="{Binding Notice, Converter={StaticResource VisibleWhenSet}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding DismissNoticeCommand}" Content="Dismiss" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding RestoreLiveCommand}" Margin="0,0,8,0"
                            Content="Put the last slide back on screen" Visibility="{Binding CanRestoreLive, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Background="#5F1E1E" Padding="12,6" Visibility="{Binding Problem, Converter={StaticResource VisibleWhenSet}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding DismissProblemCommand}" Content="Dismiss" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OpenLogs_Click" Content="Open log" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Problem}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Main area -->
        <Grid Grid.Row="2" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="400" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: service + library -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Panel}" Grid.Row="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="SERVICE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="ServiceMenu_Click" ToolTip="Service options">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE712;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding NewServiceCommand}" ToolTip="New service">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" />
                            </Button>
                            <ComboBox Margin="8,0,4,0" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding AddCurrentToServiceCommand}" ToolTip="Add the open song or presentation to this service" Margin="0,0,6,0">
                                <TextBlock Text="+ Add open item" />
                            </Button>
                            <Button Command="{Binding AddHeaderCommand}" ToolTip="Add a section header">
                                <TextBlock Text="+ Header" />
                            </Button>
                        </StackPanel>
                        <ListBox x:Name="ServiceList" ItemsSource="{Binding ServiceItems}" SelectedItem="{Binding SelectedServiceItem}"
                                 AllowDrop="True" Drop="ServiceList_Drop" DragOver="ServiceList_DragOver"
                                 MouseDoubleClick="ServiceList_DoubleClick" PreviewMouseLeftButtonDown="ServiceList_PreviewMouseDown"
                                 PreviewMouseMove="ServiceList_PreviewMouseMove">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Num" Text="{Binding Number}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" />
                                        <TextBlock x:Name="Icon" Grid.Column="1" FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedText}" FontSize="12" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="ItemName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="ItemDetail" Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"
                                                       Visibility="{Binding Detail, Converter={StaticResource VisibleWhenSet}}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{StaticResource Live}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
                                            <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="ItemName" Property="Foreground" Value="{Binding Accent}" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{Binding Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter TargetName="ItemDetail" Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Go live" Click="ServiceGoLive_Click" />
                                    <MenuItem Header="Rename…" Click="ServiceItemRename_Click" />
                                    <Separator />
                                    <MenuItem Header="Move up" Command="{Binding MoveServiceItemUpCommand}" />
                                    <MenuItem Header="Move down" Command="{Binding MoveServiceItemDownCommand}" />
                                    <Separator />
                                    <MenuItem Header="Remove from service" Command="{Binding RemoveServiceItemCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Style="{StaticResource Panel}" Grid.Row="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="LibrarySearchBox" DockPanel.Dock="Top" Text="{Binding LibrarySearch, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search songs, lyrics, authors…"
                                 ToolTip="Search titles, authors, CCLI numbers and lyrics (Ctrl+F)" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="All" Margin="0,0,10,0" IsChecked="True" Checked="LibraryFilter_Checked" Tag="0" />
                            <RadioButton Content="Songs" Margin="0,0,10,0" Checked="LibraryFilter_Checked" Tag="1" />
                            <RadioButton Content="Presentations" Checked="LibraryFilter_Checked" Tag="2" />
                        </StackPanel>
                        <ListBox x:Name="LibraryList" ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryEntry}"
                                 PreviewMouseLeftButtonDown="LibraryList_PreviewMouseDown" PreviewMouseMove="LibraryList_PreviewMouseMove"
                                 MouseDoubleClick="LibraryList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LibraryEntryViewModel}">
                                    <DockPanel>
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" Foreground="{StaticResource MutedText}"
                                                   Width="22" VerticalAlignment="Center" FontSize="12" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add to service" Command="{Binding AddCurrentToServiceCommand}" />
                                    <MenuItem Header="Edit lyrics…" Click="EditLyrics_Click" />
                                    <MenuItem Header="Rename…" Click="RenamePresentation_Click" />
                                    <MenuItem Header="Duplicate" Command="{Binding DuplicatePresentationCommand}" />
                                    <Separator />
                                    <MenuItem Header="Move to Trash" Click="DeletePresentation_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Centre: the open presentation -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasPresentation, Converter={StaticResource Visible}}">
                                <TextBlock Text="Arrangement" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Arrangements}" SelectedItem="{Binding SelectedArrangement}" MinWidth="120" Margin="0,0,12,0" />
                                <TextBlock Text="Theme" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding CurrentThemeChoice}" MinWidth="150" Margin="0,0,12,0" />
                                <Button Click="EditLyrics_Click" Margin="0,0,6,0" ToolTip="Edit the words, sections and order (double-click a song)">
                                    <TextBlock Text="Edit lyrics" />
                                </Button>
                                <Button Click="Background_Click" ToolTip="Set or clear a background for the whole song">
                                    <TextBlock Text="Background" />
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonDown="Title_MouseDown" ToolTip="Double-click to rename" />
                                <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Slide inspector (Edit mode) -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,10" Height="320">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditing}" Value="True" />
                                            <Condition Binding="{Binding HasSelectedSlide}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedSlide.Number, StringFormat=SLIDE {0}}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button Command="{Binding AddSlideCommand}" Margin="0,0,6,0" ToolTip="Add a slide after this one">
                                    <TextBlock Text="+ Slide" />
                                </Button>
                                <Button Command="{Binding DuplicateSlideCommand}" Margin="0,0,6,0" Content="Duplicate" />
                                <Button Command="{Binding MoveSlideEarlierCommand}" Margin="0,0,6,0" ToolTip="Move earlier">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76B;" />
                                </Button>
                                <Button Command="{Binding MoveSlideLaterCommand}" Margin="0,0,6,0" ToolTip="Move later">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76C;" />
                                </Button>
                                <Button Command="{Binding DeleteSlideCommand}" Margin="0,0,16,0" Content="Delete" />
                                <TextBlock Text="Design" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Designs}" SelectedItem="{Binding SelectedDesign}" MinWidth="170" Margin="0,0,6,0" />
                                <Button Command="{Binding ApplyDesignToAllSlidesCommand}" Content="Use for all" Margin="0,0,6,0" />
                                <Button Command="{Binding ClearSlideBackgroundCommand}" Content="Clear background" Margin="0,0,6,0"
                                        Visibility="{Binding SlideHasBackground, Converter={StaticResource Visible}}" />
                                <TextBlock Text="Colour" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <v:ColorPicker Hex="{Binding SlideBackgroundColor}" ToolTip="Slide background colour" />
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="ADD" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Command="{Binding AddTextBoxCommand}" Content="Text" Margin="0,0,4,0" />
                                <Button Command="{Binding AddBoxCommand}" Content="Box" Margin="0,0,4,0" />
                                <Button Command="{Binding AddCircleCommand}" Content="Circle" Margin="0,0,4,0" />
                                <Button Command="{Binding AddMediaObjectCommand}" Content="Media" Margin="0,0,14,0" ToolTip="Place the image or video selected in the Media bin" />
                                <TextBlock Text="ARRANGE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Command="{Binding BringToFrontCommand}" Content="Front" Margin="0,0,4,0" />
                                <Button Command="{Binding SendToBackCommand}" Content="Back" Margin="0,0,4,0" />
                                <Button Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip="Align left (to the slide when one is selected)" Margin="0,0,2,0">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E4;" />
                                </Button>
                                <Button Command="{Binding AlignCommand}" CommandParameter="CenterX" ToolTip="Centre horizontally" Margin="0,0,2,0">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E3;" />
                                </Button>
                                <Button Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip="Align right" Margin="0,0,2,0">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E2;" />
                                </Button>
                                <Button Command="{Binding AlignCommand}" CommandParameter="Top" Content="Top" Margin="0,0,2,0" />
                                <Button Command="{Binding AlignCommand}" CommandParameter="CenterY" Content="Middle" Margin="0,0,2,0" />
                                <Button Command="{Binding AlignCommand}" CommandParameter="Bottom" Content="Bottom" Margin="0,0,14,0" />
                                <Button Command="{Binding ResetToThemeCommand}" Content="Reset to theme" Margin="0,0,4,0"
                                        ToolTip="Give the selected text (or all text) its theme position and style back" />
                                <Button Command="{Binding DuplicateSelectedObjectsCommand}" Content="Duplicate" Margin="0,0,4,0" />
                                <Button Command="{Binding DeleteSelectedObjectsCommand}" Content="Delete" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SlideTextFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SlideTextFieldViewModel}">
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="56" FontSize="14" VerticalScrollBarVisibility="Auto" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Notes (shown to you, never to the room)" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding SlideNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                </StackPanel>
                                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <TextBlock Text="Click something on the slide to change its font, colour, size and position."
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Visibility="{Binding Inspector, Converter={StaticResource VisibleWhenSet}, ConverterParameter=invert}" />
                                        <ContentControl Content="{Binding Inspector}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate DataType="{x:Type vm:ObjectInspectorViewModel}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBox Text="{Binding X, UpdateSourceTrigger=LostFocus}" Width="58" Margin="0,0,8,0" KeyDown="NumberBox_KeyDown" />
                                                            <TextBlock Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBox Text="{Binding Y, UpdateSourceTrigger=LostFocus}" Width="58" Margin="0,0,8,0" KeyDown="NumberBox_KeyDown" />
                                                            <TextBlock Text="W" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBox Text="{Binding W, UpdateSourceTrigger=LostFocus}" Width="58" Margin="0,0,8,0" KeyDown="NumberBox_KeyDown" />
                                                            <TextBlock Text="H" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBox Text="{Binding H, UpdateSourceTrigger=LostFocus}" Width="58" Margin="0,0,8,0" KeyDown="NumberBox_KeyDown" />
                                                            <TextBlock Text="↻" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Rotation (degrees)" />
                                                            <TextBox Text="{Binding Rotation, UpdateSourceTrigger=LostFocus}" Width="48" KeyDown="NumberBox_KeyDown" />
                                                        </WrapPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Text="Opacity" Style="{StaticResource Muted}" Width="56" VerticalAlignment="Center" />
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding Opacity}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <!-- Text -->
                                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource Visible}}">
                                                            <TextBox x:Name="InspectorText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                                     TextWrapping="Wrap" MinHeight="48" Margin="0,0,0,6" />
                                                            <WrapPanel Margin="0,0,0,6">
                                                                <ComboBox ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}"
                                                                          IsEditable="True" Width="160" Margin="0,0,6,0" ToolTip="Font" />
                                                                <TextBox Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" Width="48" Margin="0,0,6,0" ToolTip="Size"
                                                                         KeyDown="NumberBox_KeyDown" />
                                                                <ToggleButton IsChecked="{Binding Bold}" Content="B" FontWeight="Bold" Width="30" Margin="0,0,2,0" />
                                                                <ToggleButton IsChecked="{Binding Italic}" Content="I" FontStyle="Italic" Width="30" Margin="0,0,6,0" />
                                                                <v:ColorPicker Hex="{Binding TextColor}" ToolTip="Text colour" />
                                                            </WrapPanel>
                                                            <WrapPanel Margin="0,0,0,6">
                                                                <ComboBox SelectedIndex="{Binding Alignment}" Width="90" Margin="0,0,6,0" ToolTip="Horizontal alignment">
                                                                    <ComboBoxItem Content="Left" />
                                                                    <ComboBoxItem Content="Centre" />
                                                                    <ComboBoxItem Content="Right" />
                                                                </ComboBox>
                                                                <ComboBox SelectedIndex="{Binding VerticalAlignment}" Width="90" Margin="0,0,6,0" ToolTip="Vertical alignment">
                                                                    <ComboBoxItem Content="Top" />
                                                                    <ComboBoxItem Content="Middle" />
                                                                    <ComboBoxItem Content="Bottom" />
                                                                </ComboBox>
                                                                <TextBlock Text="Line" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBox Text="{Binding LineHeight, UpdateSourceTrigger=LostFocus}" Width="42" Margin="0,0,6,0" ToolTip="Line height"
                                                                         KeyDown="NumberBox_KeyDown" />
                                                                <TextBlock Text="Spacing" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBox Text="{Binding Tracking, UpdateSourceTrigger=LostFocus}" Width="42" ToolTip="Letter spacing"
                                                                         KeyDown="NumberBox_KeyDown" />
                                                            </WrapPanel>
                                                            <WrapPanel>
                                                                <CheckBox Content="CAPS" IsChecked="{Binding Uppercase}" Margin="0,0,10,0" />
                                                                <CheckBox Content="Shrink to fit" IsChecked="{Binding AutoShrink}" Margin="0,0,10,0" />
                                                                <CheckBox Content="Shadow" IsChecked="{Binding Shadow}" Margin="0,0,10,0" />
                                                                <TextBlock Text="Outline" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <v:ColorPicker Hex="{Binding OutlineColor}" />
                                                            </WrapPanel>
                                                            <TextBlock Text="This text takes its look from the theme until you change something here."
                                                                       Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Visibility="{Binding InheritsTheme, Converter={StaticResource Visible}}" />
                                                        </StackPanel>
                                                        <!-- Shape -->
                                                        <WrapPanel Visibility="{Binding IsShape, Converter={StaticResource Visible}}">
                                                            <TextBlock Text="Fill" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <v:ColorPicker Hex="{Binding FillColor}" Margin="0,0,8,0" />
                                                            <TextBlock Text="Corners" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBox Text="{Binding CornerRadius, UpdateSourceTrigger=LostFocus}" Width="42" Margin="0,0,8,0" KeyDown="NumberBox_KeyDown" />
                                                            <CheckBox Content="Circle" IsChecked="{Binding IsEllipse}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Outline" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,4,4,0" />
                                                            <v:ColorPicker Hex="{Binding StrokeColor}" Margin="0,4,4,0" />
                                                            <TextBox Text="{Binding StrokeWidth, UpdateSourceTrigger=LostFocus}" Width="42" Margin="0,4,0,0" ToolTip="Outline width"
                                                                     KeyDown="NumberBox_KeyDown" />
                                                        </WrapPanel>
                                                        <!-- Media -->
                                                        <DockPanel Visibility="{Binding IsMedia, Converter={StaticResource Visible}}">
                                                            <TextBlock Text="Fit" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <ComboBox SelectedIndex="{Binding ScaleMode}" Width="140" HorizontalAlignment="Left">
                                                                <ComboBoxItem Content="Fill (crop)" />
                                                                <ComboBoxItem Content="Fit (whole picture)" />
                                                                <ComboBoxItem Content="Stretch" />
                                                            </ComboBox>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Filmstrip (Edit mode) -->
                    <Border DockPanel.Dock="Top" Padding="10,8,10,0" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Slides}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SlideTileViewModel}">
                                        <Border x:Name="Frame" Width="128" Margin="0,0,6,6" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent"
                                                Background="#141414" Cursor="Hand" MouseLeftButtonUp="SlideTile_Click" MouseRightButtonUp="SlideTile_RightClick">
                                            <StackPanel>
                                                <r:SceneView StaticScene="{Binding Scene}" Height="72" />
                                                <Grid Background="{Binding GroupBrush}" Height="16">
                                                    <TextBlock Margin="4,0" VerticalAlignment="Center" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Number, Mode=OneWay}" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid>
                        <v:SlideCanvasEditor x:Name="CanvasEditor" Margin="10"
                                             Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" />
                        <ScrollViewer x:Name="SlideScroller" VerticalScrollBarVisibility="Auto" Padding="14,12,4,0"
                                      Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter=invert}">
                            <ItemsControl x:Name="SlideGrid" ItemsSource="{Binding Slides}" ItemTemplate="{StaticResource SlideTile}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasPresentation, Converter={StaticResource Visible}, ConverterParameter=invert}">
                            <TextBlock Text="Pick a song or presentation" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="from the service or the library, or start a new one." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <Slider HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="120" Margin="0,0,16,8" Minimum="120" Maximum="420"
                                Value="{Binding Settings.ThumbnailSize}" ValueChanged="ThumbSize_Changed" ToolTip="Thumbnail size" Opacity="0.7" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: live control -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Background="{StaticResource Live}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="AUDIENCE" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding LiveDetail}" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Visibility="{Binding GoToBuffer, Converter={StaticResource VisibleWhenSet}}" ToolTip="Press Enter to go to this slide, Esc to cancel">
                                    <TextBlock Text="{Binding GoToBuffer, StringFormat=Go to {0} ⏎}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding LiveTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border CornerRadius="4" ClipToBounds="True" Background="Black">
                                <r:SceneView x:Name="AudiencePreview" PlaysVideo="True" PlaybackScope="live"
                                             Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SixteenByNine}}" />
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding PreviousCommand}" Margin="0,0,4,0" Padding="8,8" ToolTip="Previous slide (Left arrow)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76B;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Previous" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding NextCommand}" Style="{StaticResource AccentButton}" Margin="4,0,0,0" Padding="8,8"
                                        ToolTip="Next slide (Right arrow, Space, Enter)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Next" />
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76C;" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="CLEAR" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <WrapPanel>
                                <Button Style="{StaticResource ClearButton}" Command="{Binding ClearAllCommand}" Background="#7F1D1D" BorderBrush="#991B1B" ToolTip="Clear everything (F1)">
                                    <TextBlock Text="All  F1" />
                                </Button>
                                <Button Style="{StaticResource ClearButton}" Command="{Binding ClearSlideCommand}" ToolTip="Clear the slide text (F2)">
                                    <TextBlock Text="Slide  F2" />
                                </Button>
                                <Button Style="{StaticResource ClearButton}" Command="{Binding ClearMediaCommand}" ToolTip="Clear backgrounds and videos (F3)">
                                    <TextBlock Text="Media  F3" />
                                </Button>
                                <Button Style="{StaticResource ClearButton}" Command="{Binding ClearOverlaysCommand}" ToolTip="Clear overlays (F4)">
                                    <TextBlock Text="Overlays  F4" />
                                </Button>
                                <Button Style="{StaticResource ClearButton}" Command="{Binding ClearAlertsCommand}" ToolTip="Clear the message (F6)">
                                    <TextBlock Text="Message  F6" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Background="#B45309" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="STAGE" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <ComboBox ItemsSource="{Binding StageLayouts}" SelectedItem="{Binding SelectedStageLayout}" DisplayMemberPath="Name" />
                            </DockPanel>
                            <Border CornerRadius="4" ClipToBounds="True" Background="Black">
                                <r:SceneView x:Name="StagePreview" PlaysVideo="False" PlaybackScope="stage-preview"
                                             Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SixteenByNine}}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="TIMERS" Style="{StaticResource SectionLabel}" />
                            <ItemsControl ItemsSource="{Binding TimerRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimerRowViewModel}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="11" MouseLeftButtonDown="TimerName_MouseDown"
                                                           ToolTip="Double-click to rename or set the time" Cursor="Hand" />
                                                <TextBlock Text="{Binding Display}" Foreground="{Binding DisplayBrush}" FontSize="22" FontWeight="SemiBold"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="4,0" Width="34" ToolTip="Start / pause">
                                                <TextBlock FontFamily="{StaticResource Icons}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE768;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE769;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Grid.Column="2" Command="{Binding DataContext.ResetTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Width="34" ToolTip="Reset">
                                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72C;" />
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Remove timer">
                                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Text="{Binding NewTimerMinutes, UpdateSourceTrigger=PropertyChanged}" Width="44" ToolTip="Minutes" />
                                <TextBlock Text="min" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                <Button Command="{Binding AddCountdownTimerCommand}" Content="+ Countdown" Margin="0,0,6,0" />
                                <Button Command="{Binding AddCountUpTimerCommand}" Content="+ Count up" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="MESSAGE" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding AlertText, UpdateSourceTrigger=PropertyChanged}" Tag="Type a message, press Enter"
                                     ToolTip="e.g. Parent of child 47, please come to the nursery. {Sermon} shows a timer."
                                     KeyDown="AlertText_KeyDown" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox Content="Stage" IsChecked="{Binding AlertOnStage}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <CheckBox Content="Audience" IsChecked="{Binding AlertOnAudience}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Button Command="{Binding ShowAlertCommand}" Style="{StaticResource AccentButton}" Content="Show" Margin="0,0,6,0" />
                                <Button Command="{Binding ClearAlertsCommand}" Content="Clear" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Bottom bin: media or overlays -->
        <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="8,0,8,8" AllowDrop="True" Drop="MediaBin_Drop" DragOver="MediaBin_DragOver">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <ToggleButton Content="Media" Padding="12,3" IsChecked="{Binding ShowingOverlays, Converter={StaticResource Not}}" />
                    <ToggleButton Content="Overlays" Padding="12,3" Margin="4,0,12,0" IsChecked="{Binding ShowingOverlays}"
                                  ToolTip="Lower thirds, tickers and bars that sit on top of the slide (F4 clears them)" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding ShowingOverlays, Converter={StaticResource Visible}, ConverterParameter=invert}">
                        <TextBlock Text="Click to show · right-click for options · drop files here" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" />
                        <Button Command="{Binding ImportMediaCommand}" Content="+ Import images &amp; videos" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ShowingOverlays, Converter={StaticResource Visible}}">
                        <TextBlock Text="Click to put up or take down · F4 clears all" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" />
                        <Button Command="{Binding DuplicateOverlayCommand}" Content="Duplicate" ToolTip="Make your own copy of the selected overlay" />
                    </StackPanel>
                    <TextBox Text="{Binding MediaSearch, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" Tag="Search media…"
                             Visibility="{Binding ShowingOverlays, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <ComboBox ItemsSource="{Binding OverlayPacks}" SelectedItem="{Binding SelectedOverlayPack}" Width="180" HorizontalAlignment="Left"
                              Visibility="{Binding ShowingOverlays, Converter={StaticResource Visible}}" />
                </DockPanel>
                <!-- Overlays -->
                <Grid Visibility="{Binding ShowingOverlays, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Overlays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OverlayTileViewModel}">
                                    <Border x:Name="Frame" Width="170" Margin="0,0,8,0" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent"
                                            Background="#141414" Cursor="Hand" MouseLeftButtonUp="OverlayTile_Click" ToolTip="{Binding Category}">
                                        <Grid>
                                            <r:SceneView StaticScene="{Binding Preview}" PlaysVideo="False" Height="92" />
                                            <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="5,2">
                                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="1" Width="360" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedOverlay, Converter={StaticResource VisibleWhenSet}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOverlay.Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding OverlayTextFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SlideTextFieldViewModel}">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="11" Width="90" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Media -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowingOverlays, Converter={StaticResource Visible}, ConverterParameter=invert}">
                    <ItemsControl ItemsSource="{Binding MediaItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MediaTileViewModel}">
                                <Border x:Name="Frame" Width="170" Margin="0,0,8,0" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" Background="#141414"
                                        Cursor="Hand" MouseLeftButtonUp="MediaTile_Click" ToolTip="{Binding Name}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show now" Click="MediaShow_Click" />
                                            <MenuItem Header="Use as background for the open song" Click="MediaAsSongBackground_Click" />
                                            <MenuItem Header="Use as background for the selected slide" Click="MediaAsSlideBackground_Click" />
                                            <MenuItem Header="Add to service" Click="MediaAddToService_Click" />
                                            <Separator />
                                            <MenuItem Header="Loop on / off" Click="MediaToggleLoop_Click" />
                                            <MenuItem Header="Switch background / foreground" Click="MediaToggleKind_Click" />
                                            <MenuItem Header="Rename…" Click="MediaRename_Click" />
                                            <Separator />
                                            <MenuItem Header="Move to Trash" Click="MediaDelete_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <r:SceneView StaticScene="{Binding Preview}" PlaysVideo="False" Height="92" />
                                        <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="5,2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource MutedText}" Margin="4,0,0,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Live}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
