<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral show logic shared by the Windows app and its tests:
       document models (generated from packages/schema/documents.json), the
       library store, lyric import, scene building, live show state, timers
       and stage display layouts. No UI or Windows APIs live here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MxU.Slides.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MxU.Slides.Core.Tests" />
  </ItemGroup>

  <!-- The Bible texts (KJV, WEB, ASV) and their manifest, built into the DLL so they travel with
       the app and its tests. Scripture/BibleCatalog.cs reads them as "Bibles/<file>".
       tools/bible-convert.py makes them from eBible.org's downloads. -->
  <ItemGroup>
    <None Remove="Scripture\Bibles\**" />
    <EmbeddedResource Include="Scripture\Bibles\*.tsv.gz;Scripture\Bibles\bibles.json" LogicalName="Bibles/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
