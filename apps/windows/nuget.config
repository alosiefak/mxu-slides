<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Windows app restores only from nuget.org, whatever the machine's own NuGet setup. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
